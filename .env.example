# ==============================================================================
# Plantilla de Variables de Entorno - SGR Municipalidad de La Serena
# Copiar este archivo como .env y configurar con credenciales reales
# ==============================================================================

SECRET_KEY=tu_clave_secreta_aqui
DEBUG=True
ALLOWED_HOSTS=*

# Motor de Base de Datos: 'sqlite' o 'mysql'
DB_ENGINE=sqlite

# Parámetros para MySQL (AWS EC2 / phpMyAdmin)
DB_NAME=sgr_municipalidad
DB_USER=sgr_user
DB_PASSWORD=tu_contraseña_segura
DB_HOST=localhost
DB_PORT=3306
